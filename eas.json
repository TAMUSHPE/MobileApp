{
  "cli": {
    "version": ">= 4.1.2",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging"
    },
    "member-apk": {
      "distribution": "internal",
      "channel": "production",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "development-sim": {
      "distribution": "internal",
      "developmentClient": true,
      "environment": "development",
      "ios": {
        "simulator": false,
        "image": "latest",
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
